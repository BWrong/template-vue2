{
  "name": "template-vue2",
  "version": "0.0.1",
  "private": true,
  "author": {
    "name": "BWrong",
    "email": "ibwrong@foxmail.com",
    "url": "https://github.com/BWrong"
  },
  "scripts": {
    "start": "npm run serve",
    "serve": "vue-cli-service serve",
    "serve:mock": "vue-cli-service serve --mode mock",
    "build": "vue-cli-service build",
    "build:report": "vue-cli-service build --report",
    "lint": "vue-cli-service lint",
    "lint:style": "stylelint src/**/*.{vue,css,less,scss} --fix",
    "prettier": "npx prettier --write ./src",
    "release": "standard-version --infile docs/CHANGELOG.md",
    "commit": "git add . && git-cz"
  },
  "dependencies": {
    "@bwrong/auth-tool": "2.2.0",
    "ant-design-vue": "^1.7.8",
    "axios": "^0.27.0",
    "core-js": "^3.26.0",
    "crypto-js": "^4.1.1",
    "js-cookie": "^3.0.1",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "nprogress": "^0.2.0",
    "qs": "^6.11.0",
    "vue": "2.7.10",
    "vue-router": "^3.5.3",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.19.6",
    "@babel/eslint-parser": "^7.19.1",
    "@bwrong/mock": "0.0.14",
    "@rushstack/eslint-patch": "^1.2.0",
    "@vanwei/eslint-config": "^1.1.6",
    "@vanwei/stylelint-config": "^1.0.4",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-eslint": "~5.0.8",
    "@vue/cli-plugin-router": "~5.0.8",
    "@vue/cli-plugin-vuex": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "@vue/eslint-config-prettier": "^7.0.0",
    "autoprefixer": "^10.4.13",
    "babel-plugin-import": "^1.13.5",
    "commitizen": "^4.2.5",
    "compression-webpack-plugin": "^10.0.0",
    "cz-customizable": "^7.0.0",
    "eslint": "^8.26.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.7.0",
    "git-revision-webpack-plugin": "^5.0.0",
    "less": "^3.13.1",
    "less-loader": "^7.2.0",
    "lint-staged": "^13.0.3",
    "postcss": "^8.4.19",
    "postcss-html": "^1.5.0",
    "postcss-less": "^6.0.0",
    "prettier": "^2.7.1",
    "regenerator-runtime": "0.13.10",
    "standard-version": "^9.5.0",
    "stylelint": "^14.15.0",
    "stylelint-config-recommended": "^9.0.0",
    "stylelint-order": "^5.0.0",
    "vue-eslint-parser": "^9.1.0",
    "vue-template-compiler": "^2.7.13",
    "yorkie": "^2.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "webpack"
      ]
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },

  "gitHooks": {
    "pre-commit": "lint-staged --allow-empty"
  },
  "lint-staged": {
    "*.{vue,js,jsx,cjs,mjs,ts,tsx}": [
      "npm run lint",
      "prettier --write"
    ],
    "*.{css,less}": [
      "npm run lint:style",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "standard-version": {
    "skip": {
      "commit": false
    }
  }
}
